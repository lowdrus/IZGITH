{
  "manifest_version": 3,
  "name": "IZGITH Portable - Mission Control",
  "version": "6.0.0.00042",
  "action": { "default_popup": "ui/popup.html" },
  "background": { "service_worker": "sw.js" },
  "permissions": ["storage","downloads","tabs","scripting","activeTab"],
  "host_permissions": ["*://chat.openai.com/*","*://chatgpt.com/*"],
  "icons": {
    "16": "ui/assets/icons/icon16.png",
    "32": "ui/assets/icons/icon32.png",
    "48": "ui/assets/icons/icon48.png",
    "128": "ui/assets/icons/icon128.png"
  }
}