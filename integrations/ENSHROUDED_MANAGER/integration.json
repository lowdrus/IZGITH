{
  "id": "enshrouded-manager",
  "name": "ENSHGERENC",
  "status": "ui-v4-unified-runtime-agent",
  "entry": "../../extension/integrations/enshrouded-manager.js",
  "scope": "local Enshrouded server profiles, configuration, lifecycle, backups, players and orchestration",
  "source_reference": "https://github.com/lincolnthalles/enshrouded-container",
  "source_component": "src/enshctl",
  "reference_capabilities": ["version pinning", "install/update planning", "start/stop lifecycle", "scheduled/live/cold/emergency backups", "retention", "restore", "mod overlay", "CPU/RSS polling", "configuration generation"],
  "capabilities": ["create-profile", "save-profile", "validate-endpoint", "start", "stop", "restart", "update", "players", "kick", "ban", "unban", "backup", "restore", "prune", "mods", "resources", "version", "generate-server-config", "generate-docker-compose"],
  "external_process": false,
  "native_messaging": false,
  "docker_execution": false,
  "runtime_agent": {
    "enabled": true,
    "default_endpoint": "http://127.0.0.1:38751",
    "health": "/health",
    "operation_prefix": "/v1/operations/",
    "endpoint_contract": "integrations/ENSHROUDED_MANAGER/runtime-agent-endpoint.json",
    "contract": "integrations/ENSHROUDED_MANAGER/runtime-contract.json",
    "auth": "Bearer session token, never stored in source"
  },
  "ui": {"embedded_in_dashboard_servers_card": true, "entry_page": "extension/ui/enshrouded.html", "visual_layer": "enshrouded-manager.css", "unified_control_panel": true},
  "security_boundary": "browser-control-plane-runtime-agent-executor",
  "description": "Painel ENSHGERENC alinhado ao enshrouded-container. A extensão gera e controla planos; execução de Docker/Wine/Steam/DepotDownloader fica no Runtime Agent explicitamente instalado e autorizado pelo sistema operacional."
}
